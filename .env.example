PEXELS_API_KEY=your_pexels_api_key_here
PEXELS_VALIDATION_TIMEOUT_MS=12000
LOG_LEVEL=info
PORT=3123
DATA_DIR_PATH=/app/data
DOCKER=true
DEV=false
REQUEST_TIMEOUT_MS=30000
PROVIDER_TIMEOUT_MS=45000
WEBHOOK_TIMEOUT_MS=10000
MIN_FREE_DISK_BYTES=536870912
TEMP_MAX_AGE_MS=86400000
HEALTH_CACHE_TTL_MS=10000
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=60000
WHISPER_MODEL=small
KOKORO_MODEL_PRECISION=q4
CONCURRENCY=1
VIDEO_CACHE_SIZE_IN_BYTES=2097152000
WHISPER_VERBOSE=false

# Arabic/Egyptian production voice is Local Voice (VoiceTut, GPU, host-native)
# by default, with KemeTone as the local CPU fallback - see LOCAL_TTS_BASE_URL
# below. ElevenLabs is an optional, explicitly opt-in premium route configured
# from the app: Providers -> ElevenLabs -> Configure. It is never a silent
# fallback for the default Local Voice route.
# The key is stored encrypted in the provider vault; editing this file is not required.
ELEVENLABS_API_KEY=
# Optional. Leave empty to resolve the voice from your ElevenLabs account,
# or set the voice you selected in Providers -> ElevenLabs -> Voice Lab.
ELEVENLABS_DEFAULT_VOICE_ID=

# Local Voice (VoiceTut/KemeTone) runs host-native on Windows, not in a
# container - see docker-compose.prod.yml. The app/render-worker reach it here.
LOCAL_TTS_BASE_URL=http://host.docker.internal:8765

# Legacy Piper Arabic runtime. NOT required for production: Arabic narration is
# served by ElevenLabs. These are only needed to re-open or re-render historical
# jobs that were produced with Piper before V2.2.
# PIPER_BIN=/opt/piper/bin/piper
# PIPER_AR_MODEL_PATH=/app/data/models/piper/ar_JO-kareem-medium.onnx
# PIPER_AR_MODEL_CONFIG_PATH=/app/data/models/piper/ar_JO-kareem-medium.onnx.json
# PIPER_AR_VOICE_ID=ar_JO-kareem-medium

# Optional Google Cloud Text-to-Speech provider (server-side only; never expose credential JSON to the browser)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_TTS_DEFAULT_VOICE=
GOOGLE_CLOUD_TTS_SPEAKING_RATE=1.0
GOOGLE_CLOUD_TTS_PITCH=0
GOOGLE_CLOUD_TTS_SAMPLE_RATE=24000

# V2 control plane
V2_ENABLED=true
INTERNAL_SERVICE_TOKEN=change-this-long-random-internal-token
PROVIDER_VAULT_MASTER_KEY=change-this-64-hex-character-provider-vault-key
# Fresh installs: short_studio. Installs upgraded from ABUD Shorts Engine 2.4
# keep POSTGRES_DB/POSTGRES_USER=abud_shorts - the installer/updater carries
# the existing values forward rather than rewriting them, since the running
# PostgreSQL database was already created with that name/owner.
POSTGRES_DB=short_studio
POSTGRES_USER=short_studio
POSTGRES_PASSWORD=change-this-postgres-password
N8N_ENCRYPTION_KEY=change-this-32-character-n8n-key
GENERIC_TIMEZONE=Africa/Cairo

# Container/volume/network identity. Fresh installs use the short-studio-*
# defaults below and never need to set these. An installation upgraded from
# ABUD Shorts Engine 2.4 keeps these pinned to its existing abud-shorts-*
# names instead, so it reattaches to the same containers/volumes/network
# rather than creating empty new ones - see docker-compose.prod.yml.
# SHORT_STUDIO_CONTAINER_PREFIX=short-studio
# SHORT_STUDIO_POSTGRES_VOLUME=short-studio-postgres-data
# SHORT_STUDIO_N8N_VOLUME=short-studio-n8n-data
# SHORT_STUDIO_NETWORK=short-studio-v2

# V2.2 optional capability packs are disabled by default.
EDGE_TTS_ENABLED=false
EDGE_TTS_BIN=
EDGE_TTS_DEFAULT_VOICE=ar-EG-SalmaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_PITCH=+0Hz
EDGE_TTS_VOLUME=+0%
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:9b-q4_K_M
QUALITY_CPU_PACK_ENABLED=false
MOTION_CANVAS_ENABLED=false
MOTION_CANVAS_BIN=
PYSCENEDETECT_BIN=
MEDIAPIPE_BIN=
REMBG_BIN=
REAL_ESRGAN_BIN=
REAL_ESRGAN_MODE=off
LIBROSA_PYTHON=
FASTER_WHISPER_BIN=
WHISPERX_BIN=
AI_GPU_PACK_ENABLED=false
COMFYUI_BASE_URL=
WAN22_ENABLED=false
