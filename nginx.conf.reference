# ==============================================================================
# ABUD Shorts Engine V2 — Reference Nginx Reverse Proxy Configuration
# ==============================================================================

upstream abud_shorts_app {
    server 127.0.0.1:3130;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name shorts.yourdomain.com;

    # Redirect all HTTP traffic to HTTPS (Recommended)
    # return 301 https://$host$request_uri;

    client_max_body_size 2048M; # Allow large video/asset uploads

    # Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Root Application Proxy
    location / {
        proxy_pass http://abud_shorts_app;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
    }

    # Server-Sent Events (SSE) Live Streams
    location ~* ^/api/v2/(events|publishing/events)/stream {
        proxy_pass http://abud_shorts_app;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
        proxy_read_timeout 24h;
    }

    # Video Range Requests & Media Streaming
    location ~* ^/api/(short-video|videos) {
        proxy_pass http://abud_shorts_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;
        proxy_force_ranges on;
    }
}
